# ---- 网页服务 ----
# 端口：不要和其它项目（如 AI Finance 用的 9002）冲突
PORT=9010
# 监听地址：本机访问填 127.0.0.1；用 mlx/mihomo 之类做公网导出时填 ::（IPv6）或 0.0.0.0
HOST=127.0.0.1

# ---- 采集范围 ----
# 采集多长时间内的任务（小时）
WINDOW_HOURS=24
# Hermes 实例根目录：其下每个子目录是一个实例（含 state.db），如 hermes/ hermes2/
HERMES_BOT_ROOT=~/bot
# 被监控 CLI（claude / opencode / antigravity）的 wrapper 目录
HERMES_WRAPPER_DIR=~/.local/bin
# Claude Code 的转录目录（冒号分隔）
CLAUDE_HOMES=~/.claude:~/.claude_real:~/.claude_personal
# 运行数据目录（token / 缓存 / 上报记录）。相对路径按仓库根目录解析
MONITOR_DATA_DIR=data

# ---- 大模型 Agent（后台自动总结任务名/期望产出、生成巡检摘要）----
# 任何 OpenAI 兼容的 /v1/chat/completions 服务都行
LLM_URL=http://127.0.0.1:4000/v1/chat/completions
LLM_MODEL=ali-deepseek-v4.1-flash-nothink
LLM_KEY=sk-please-change-me
# 总结节奏（秒）：任务/工人摘要与巡检
TITLE_S=60
INSPECT_S=600

# ---- MCP 代理（backend/mcp_server.py）----
MONITOR_URL=http://127.0.0.1:9010
# 不填 MONITOR_TOKEN 时自动读取 data/.token（首次启动生成）
# MONITOR_TOKEN=
